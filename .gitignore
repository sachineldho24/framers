# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# scratch / local tooling
/tmp
.openai

# large world frame sequence — hosted externally, not committed (264 MB)
/public/world

# credentials — live keys, never commit
rzp-key.csv

# agent instructions & vendored agent skills: local tooling, not part of the app
/CLAUDE.md
/AGENTS.md
/.agents
/skills-lock.json

# local working material: planning notes, reference animations, scraped source
# images. Kept on disk, deliberately not part of the repo.
/docs
/Animations_Sample
/posterx_posters
/download_posters.sh
