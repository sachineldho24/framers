# ---------------------------------------------------------------------------
# Framers - environment variables
# Copy this file to .env.local and fill in real values.
# Full descriptions in plan/02-architecture.md.
# NEVER commit .env.local.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Project URL and anon key (Supabase Dashboard -> Project Settings -> API).
# These are PUBLIC (used in the browser client).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key - BYPASSES RLS. Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=


# --- Razorpay ---------------------------------------------------------------
# Key ID is PUBLIC (used in the checkout modal). Secret is server-only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret (Razorpay Dashboard -> Webhooks).
RAZORPAY_WEBHOOK_SECRET=

# --- Email ------------------------------------------------------------------
# Resend API key (https://resend.com/api-keys). Server-only.
EMAIL_API_KEY=
# From address. Must be a verified domain or sender in the provider.
EMAIL_FROM=Framers <orders@yourdomain.in>
# Where new-order alerts land: the inbox the framing bench actually reads.
# Replying to an alert answers the customer, not this address.
ORDER_NOTIFICATION_EMAIL=

# --- App --------------------------------------------------------------------
# Public base URL of the deployed app. Local default below.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# --- Studio templates ---------------------------------------------------------
# Gates the customer-facing Templates tab and GET /api/templates*. Admin
# upload/review at /admin/templates works regardless, so templates can be
# prepared before this is flipped on.
TEMPLATES_ENABLED=false

# Studio background removal: where the ISNet model (isnet-general-use-fp16.onnx,
# ~90 MB) is downloaded from — your Hugging Face "resolve" URL. Unset, the studio
# looks for public/models/background/isnet-general-use-fp16.onnx (dev only).
NEXT_PUBLIC_BG_MODEL_URL=

# --- Studio: generative AI (Generate with AI panel) ----------------------------
# Server-only keys, one per provider. Set any subset: the studio lists only the
# models whose provider has a key (catalogue: src/lib/aiGen/catalog.ts).
#   OpenAI (GPT Image 2.5 Flare/Sunburst, 2, 1 Mini)   https://platform.openai.com/api-keys
OPENAI_API_KEY=
#   Google Gemini (Nano Banana 2 / Pro / Lite)          https://aistudio.google.com/apikey
GEMINI_API_KEY=
#   Ideogram (4.0, Edit, Inpaint, Object/BG removal, Upscale) https://ideogram.ai/manage-api
IDEOGRAM_API_KEY=
#   Black Forest Labs (FLUX.2, Fill, Erase, Outpaint)   https://dashboard.bfl.ai
BFL_API_KEY=
#   xAI (Grok Imagine 2.0)                              https://console.x.ai
XAI_API_KEY=
#   fal.ai (one key: GPT Image, Nano Banana, Seedream, FLUX, Qwen, Recraft, Topaz,
#   BiRefNet, Seedream Layerize…)                       https://fal.ai/dashboard/keys
FAL_KEY=
#   Kie.ai (discounted Nano Banana, GPT Image, Seedream, Topaz) https://kie.ai/api-key
KIE_API_KEY=
# off | admin | on. Default admin: only admins see it until you switch it on.
AI_GENERATION=admin
# Limits over a rolling 24 h (needs migration 0016_ai_generations.sql):
AI_GEN_DAILY_LIMIT=25          # requests per customer
AI_GEN_USER_DAILY_USD=1        # estimated spend per customer
AI_GEN_DAILY_BUDGET_USD=10     # estimated spend across everyone
