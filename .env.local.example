# ---------------------------------------------------------------------------
# Framers - environment variables
# Copy this file to .env.local and fill in real values.
# Full descriptions in plan/02-architecture.md.
# NEVER commit .env.local.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Project URL and anon key (Supabase Dashboard -> Project Settings -> API).
# These are PUBLIC (used in the browser client).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key - BYPASSES RLS. Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=


# --- Razorpay ---------------------------------------------------------------
# Key ID is PUBLIC (used in the checkout modal). Secret is server-only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret (Razorpay Dashboard -> Webhooks).
RAZORPAY_WEBHOOK_SECRET=

# --- Email ------------------------------------------------------------------
# Resend API key (https://resend.com/api-keys). Server-only.
EMAIL_API_KEY=
# From address. Must be a verified domain or sender in the provider.
EMAIL_FROM=Framers <orders@yourdomain.in>
# Where new-order alerts land: the inbox the framing bench actually reads.
# Replying to an alert answers the customer, not this address.
ORDER_NOTIFICATION_EMAIL=

# --- App --------------------------------------------------------------------
# Public base URL of the deployed app. Local default below.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# --- Studio templates ---------------------------------------------------------
# Gates the customer-facing Templates tab and GET /api/templates*. Admin
# upload/review at /admin/templates works regardless, so templates can be
# prepared before this is flipped on.
TEMPLATES_ENABLED=false
